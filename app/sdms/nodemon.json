{
  "watch": ["src"],
  "ext": "ts,js,json",
  "ignore": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/docs/api", "src/docs/schemas", "src/docs/policies"],
  "exec": "node -r ts-node/register -r dotenv/config ./src/server/server-start.ts",
  "signal": "SIGTERM",
  "delay": "1000",
  "env": {
    "TS_NODE_PROJECT": "tsconfig.json"
  }
}
