{
  "name": "seismic-store-service",
  "version": "2.0.0",
  "description": "seismic store service",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist coverage test-results.xml .nyc_output",
    "clean:npm": "npx rimraf ./node_modules",
    "commit": "git-cz",
    "build": "tsc",
    "lint": "tslint -c tslint.json -p tsconfig.json 'src/**/*.ts'",
    "start": "node -r dotenv/config ./dist/server/server-start.js",
    "start:redis": "nohup redis-server > /tmp/redis.log 2>&1 &",
    "setup:dev": "(nohup redis-server > /tmp/redis.log 2>&1 &) && (npm i)",
    "test": "env UTEST=true mocha -r ts-node/register tests/utest/test.ts",
    "test-coverage": "env UTEST=true nyc mocha -r ts-node/register --reporter mocha-junit-reporter tests/utest/test.ts",
    "test-automation": "npm run clean && npm ci && npm run build && npm run test-coverage",
    "test-lcov-automation": "npm run clean && npm ci && npm run build && npm run test-lcov-coverage",
    "test-lcov-automation-aws": "npm run clean && npm ci && npm run build && npm run test-lcov-coverage-aws",
    "test-lcov-coverage-aws": "env UTEST=true nyc --reporter=lcovonly --check-coverage --lines 0 --functions 0 --branches 0 --statements 0 mocha -r ts-node/register tests/utest/test.ts",
    "test-lcov-coverage": "env UTEST=true nyc mocha -r ts-node/register -r source-map-support/register --recursive -R mocha-bamboo-reporter tests/utest/test.ts",
    "test-e2e-parallel": "node ./tests/e2e/parallel/run_e2e_tests_parallel.js",
    "copy-static-files": "copyfiles --error --up 1 ./docs/api/openapi.osdu.yaml ./dist/docs",
    "copy-schemas": "copyfiles --up 1 ./docs/schemas/**/*.json ./dist/docs",
    "copy-rego-policies": "copyfiles --up 1 ./docs/policies/*.rego ./dist/docs",
    "postbuild": "npm run copy-static-files && npm run copy-schemas && npm run copy-rego-policies"
  },
  "nyc": {
    "check-coverage": true,
    "branches": 40,
    "functions": 45,
    "lines": 45,
    "statements": 45,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/tests/**/*.ts",
      "src/config/*.ts",
      "src/metrics/*.ts"
    ],
    "extension": [
      ".ts"
    ],
    "reporter": [
      "text-summary",
      "html",
      "cobertura",
      "clover",
      "lcovonly"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "engines": {
    "node": ">= 6",
    "npm": ">= 8"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.49.0",
    "@aws-sdk/client-sts": "^3.49.0",
    "@azure/core-auth": "^1.4.0",
    "@azure/core-rest-pipeline": "^1.9.2",
    "@azure/cosmos": "^3.14.1",
    "@azure/identity": "^3.2.4",
    "@azure/keyvault-secrets": "^4.3.0",
    "@azure/storage-blob": "^12.10.0",
    "@azure/storage-queue": "^12.15.0",
    "@google-cloud/datastore": "^8.4.0",
    "@google-cloud/logging-winston": "^6.0.0",
    "@google-cloud/pubsub": "^4.1.1",
    "@google-cloud/secret-manager": "^5.0.1",
    "@google-cloud/storage": "^6.1.0",
    "@google-cloud/trace-agent": "^5.1.6",
    "@ibm-cloud/cloudant": "^0.8.2",
    "@prisma/client": "^3.8.0",
    "ajv": "^8.8.0",
    "ajv-formats": "^2.1.1",
    "applicationinsights": "^2.7.3",
    "applicationinsights-native-metrics": "^0.0.6",
    "aws-sdk": "^2.1024.0",
    "axios": "^1.7.4",
    "bull": "^4.12.2",
    "colors": "^1.4.0",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "4.17.3",
    "express-prometheus-middleware": "^1.2.0",
    "google-auth-library": "8.7.0",
    "hpropagate": "^1.0.1",
    "ioredis": "^5.1.0",
    "js-yaml": "^4.1.0",
    "json-refs": "^3.0.15",
    "jsonwebtoken": "9.0.0",
    "jwtproxy": "^1.6.8",
    "keycloak-admin": "^1.14.22",
    "log4js": "^6.3.0",
    "node-cache": "^5.1.2",
    "prisma": "^3.8.0",
    "prom-client": "^13.2.0",
    "qs": "^6.11.0",
    "redlock": "^5.0.0-beta.2",
    "replace-in-file": "^6.3.2",
    "swagger-ui-express": "^4.3.0",
    "typescript": "^4.4.4",
    "uuid": "^8.3.2",
    "winston": "3.3.3",
    "xss-filters": "1.2.7"
  },
  "devDependencies": {
    "@types/bull": "^3.15.5",
    "@types/chai": "^4.2.22",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/ioredis": "^4.28.1",
    "@types/js-yaml": "^4.0.5",
    "@types/jsonwebtoken": "^8.5.5",
    "@types/mocha": "^9.0.0",
    "@types/node": "^16.11.7",
    "@types/redlock": "^4.0.2",
    "@types/sinon": "^17.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "^8.3.1",
    "@types/xss-filters": "0.0.27",
    "async": "^3.2.2",
    "chai": "^4.3.4",
    "cz-conventional-changelog": "^3.3.0",
    "fs-jetpack": "^4.2.0",
    "inline-css": "^4.0.2",
    "ioredis-mock": "^8.2.2",
    "istanbul": "0.4.5",
    "mocha": "^9.1.3",
    "mocha-bamboo-reporter": "^1.1.2",
    "mocha-junit-reporter": "^2.0.2",
    "newman": "^6.0.0",
    "newman-reporter-htmlextra": "^1.23.1",
    "nyc": "^15.1.0",
    "scan-for-secrets": "^2.0.3",
    "sinon": "^17.0.1",
    "ts-node": "10.8.0",
    "tslint": "^6.1.3"
  },
  "overrides": {
    "degenerator": "^5.0.1",
    "ip": "2.0.1",
    "@azure/identity": {
      "@azure/msal-node": {
        "jsonwebtoken": "$jsonwebtoken",
        "semver": "7.5.2"
      }
    },
    "@babel/core": {
      "@babel/traverse": "^7.23.2",
      "semver": "^6.3.1"
    },
    "@ibm-cloud/cloudant": {
      "qs": "$qs",
      "ibm-cloud-sdk-core": {
        "axios": "1.7.4",
        "expect": {
          "jest-message-util": {
            "micromatch": "^4.0.6"
          }
        }
      }
    },
    "express": {
      "qs": "$qs"
    },
    "jsonwebtoken": {
      "semver": "7.5.2"
    },
    "jwtproxy": {
      "jsonwebtoken": "$jsonwebtoken",
      "semver": "7.5.2"
    },
    "jwks-rsa": {
      "axios": "1.7.4"
    },
    "newman": {
      "qs": "$qs",
      "semver": "7.5.2"
    },
    "keycloak-admin": {
      "axios": "1.7.4"
    }
  },
  "config": {
    "commitizen": {
      "path": "./app/sdms/node_modules/cz-conventional-changelog"
    }
  },
  "prisma": {
    "schema": "src/cloud/providers/anthos/schema.prisma"
  }
}

