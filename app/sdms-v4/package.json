{
    "name": "sdms",
    "version": "4.0.0",
    "license": "Apache-2.0",
    "repository": {
        "url": "https://community.opengroup.org/osdu/platform/domain-data-mgmt-services/seismic/seismic-dms-suite/seismic-store-service/-/tree/master/app/sdms-v4"
    },
    "description": "Seismic Domain Data Management APIs to store and manage strongly typed seismic datasets.",
    "scripts": {
        "clean": "rm -rf dist coverage test-results.xml .nyc_output",
        "clean:npm": "npx rimraf ./node_modules",
        "unit-test": "env UTEST=true mocha -r ts-node/register tests/utest/test.ts",
        "test-lcov-automation": "npm run clean && npm ci && npm run build && npm run test-lcov-coverage",
        "test-lcov-coverage": "env UTEST=true nyc --reporter=lcovonly mocha -r ts-node/register tests/utest/test.ts",
        "build": "tsc",
        "generate-docs": "node --trace-warnings ./dist/docs/docstart.js",
        "lint": "eslint --ignore-path .eslintignore --ext .js,.ts .",
        "postbuild": "npm run generate-docs",
        "prettier": "prettier -c src/**/*.ts",
        "prettier-fix": "prettier -w src/**/*.ts",
        "start-service": "node --trace-warnings --trace-uncaught ./dist/server/server-start.js",
        "test": "mocha -r ts-node/register tests/e2e/test.ts --timeout 150000 --bail --reporter mocha-multi-reporters --reporter-options configFile=./tests/e2e/config.json",
        "test-auth": "mocha -r ts-node/register tests/auth/test.ts --timeout 150000 --bail --reporter mocha-multi-reporters --reporter-options configFile=./tests/auth/config.json"
    },
    "nyc": {
        "check-coverage": true,
        "branches": 0,
        "functions": 0,
        "lines": 0,
        "statements": 0,
        "include": [
            "src/**/*.ts"
        ],
        "exclude": [
            "src/tests/**/*.ts"
        ],
        "extension": [
            ".ts"
        ],
        "reporter": [
            "lcovonly"
        ],
        "sourceMap": true,
        "instrument": true
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.410.0",
        "@aws-sdk/client-secrets-manager": "^3.421.0",
        "@aws-sdk/client-ssm": "^3.421.0",
        "@aws-sdk/client-sts": "^3.421.0",
        "@azure/core-auth": "^1.4.0",
        "@azure/core-rest-pipeline": "^1.10.1",
        "@azure/cosmos": "^4.0.0",
        "@azure/identity": "^4.4.1",
        "@azure/keyvault-secrets": "^4.7.0",
        "@azure/storage-blob": "^12.14.0",
        "@azure/storage-queue": "^12.24.0",
        "@types/qs": "^6.9.7",
        "applicationinsights": "^2.7.0",
        "axios": "^1.8.2",
        "cors": "^2.8.5",
        "express": "^4.20.0",
        "form-data": "^4.0.4",
        "hpropagate": "^1.0.1",
        "ioredis": "^5.2.4",
        "js-yaml": "^4.1.0",
        "json-refs": "^3.0.15",
        "jsonschema": "^1.4.1",
        "log4js": "^6.9.1",
        "node-cache": "^5.1.2",
        "package": "^1.0.1",
        "path-to-regexp": "^0.1.12",
        "qs": "^6.11.0",
        "swagger-ui-express": "^4.6.0",
        "typescript": "^4.9.4",
        "xss-filters": "^1.2.7"
    },
    "devDependencies": {
        "@types/chai": "^4.3.5",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.15",
        "@types/js-yaml": "^4.0.5",
        "@types/mocha": "^10.0.1",
        "@types/node": "^18.11.18",
        "@types/sinon": "^10.0.18",
        "@types/swagger-ui-express": "^4.1.3",
        "@types/uuid": "^9.0.2",
        "@types/xss-filters": "0.0.27",
        "@typescript-eslint/eslint-plugin": "^6.4.0",
        "@typescript-eslint/parser": "^6.4.0",
        "chai": "^4.5.0",
        "eslint": "^8.31.0",
        "eslint-config-prettier": "^8.6.0",
        "eslint-plugin-prettier": "^4.2.1",
        "mocha": "^10.2.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.1",
        "nyc": "^15.1.0",
        "prettier": "^2.8.1",
        "sinon": "^16.0.0",
        "ts-node": "^10.9.1"
    },
    "overrides": {
        "@azure/core-rest-pipeline": {
            "form-data": "^4.0.4"
        },
        "@typescript-eslint/parser": {
            "@typescript-eslint/typescript-estree": {
                "semver": "7.5.2"
            }
        },
        "applicationinsights": {
            "@azure/opentelemetry-instrumentation-azure-sdk": {
                "@opentelemetry/instrumentation": {
                    "semver": "7.5.2"
                }
            }
        },
        "form-data": "^4.0.4",
        "json-refs": {
            "path-loader": {
                "superagent": {
                    "semver": "7.5.2"
                }
            }
        },
        "cross-spawn": "7.0.5",
        "eslint": {
            "cross-spawn": "7.0.5"
        },
        "foreground-child": {
            "cross-spawn": "7.0.5"
        },
        "istanbul-lib-processinfo": {
            "cross-spawn": "7.0.5"
        },
        "express": {
            "path-to-regexp": "0.1.12"
        }
    }
}
